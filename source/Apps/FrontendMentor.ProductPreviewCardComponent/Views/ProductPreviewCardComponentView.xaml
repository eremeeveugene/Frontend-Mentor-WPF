<UserControl x:Class="FrontendMentor.ProductPreviewCardComponent.Views.ProductPreviewCardComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:buttons="clr-namespace:FrontendMentor.Assets.Controls.Buttons;assembly=FrontendMentor.Assets"
             xmlns:constants="clr-namespace:FrontendMentor.Core.Constants;assembly=FrontendMentor.Core"
             xmlns:converters="clr-namespace:FrontendMentor.Assets.Converters;assembly=FrontendMentor.Assets"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="clr-namespace:FrontendMentor.Assets.Controls.Panels;assembly=FrontendMentor.Assets"
             xmlns:viewModels="clr-namespace:FrontendMentor.ProductPreviewCardComponent.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:ProductPreviewCardComponentViewModel}"
             x:ClassModifier="internal"
             mc:Ignorable="d">

    <Border Width="600"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" CornerRadius="10 0 0 10">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Product.ProfileImage}" />
                </Border.Background>
            </Border>

            <Border Grid.Column="1"
                    Padding="32"
                    Background="{StaticResource ProductPreviewCardComponentView.Product.Border.Background.Brush}"
                    CornerRadius="0 10 10 0">
                <StackPanel>
                    <TextBlock Foreground="{StaticResource ProductPreviewCardComponentView.Type.TextBlock.Foreground.Brush}"
                               Style="{StaticResource Overline.TextBlock.Style}"
                               Text="{Binding Product.Type, Converter={converters:StringToUpperConverter}}">
                        <TextBlock.TextEffects>
                            <TextEffect PositionCount="1" PositionStart="1">
                                <TextEffect.Transform>
                                    <TranslateTransform X="5" />
                                </TextEffect.Transform>
                            </TextEffect>
                            <TextEffect PositionCount="1" PositionStart="2">
                                <TextEffect.Transform>
                                    <TranslateTransform X="10" />
                                </TextEffect.Transform>
                            </TextEffect>
                            <TextEffect PositionCount="1" PositionStart="3">
                                <TextEffect.Transform>
                                    <TranslateTransform X="15" />
                                </TextEffect.Transform>
                            </TextEffect>
                            <TextEffect PositionCount="1" PositionStart="4">
                                <TextEffect.Transform>
                                    <TranslateTransform X="20" />
                                </TextEffect.Transform>
                            </TextEffect>
                            <TextEffect PositionCount="1" PositionStart="5">
                                <TextEffect.Transform>
                                    <TranslateTransform X="25" />
                                </TextEffect.Transform>
                            </TextEffect>
                            <TextEffect PositionCount="1" PositionStart="6">
                                <TextEffect.Transform>
                                    <TranslateTransform X="30" />
                                </TextEffect.Transform>
                            </TextEffect>
                        </TextBlock.TextEffects>
                    </TextBlock>

                    <TextBlock Margin="0,20,0,0"
                               Style="{StaticResource Display.TextBlock.Style}"
                               Text="{Binding Product.Title}" />

                    <TextBlock Margin="0,24,0,0"
                               Foreground="{StaticResource ProductPreviewCardComponentView.Description.TextBlock.Foreground.Brush}"
                               Style="{StaticResource Body.TextBlock.Style}"
                               Text="{Binding Product.Description}" />

                    <panels:SpacingStackPanel Margin="0,29,0,0"
                                              Orientation="Horizontal"
                                              Spacing="19">
                        <TextBlock Foreground="{StaticResource ProductPreviewCardComponentView.Price.TextBlock.Foreground.Brush}" Style="{StaticResource Display.TextBlock.Style}">
                            <Run Text="{x:Static constants:SpecialCharacters.Dollar}" /><Run Text="{Binding Product.Price, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock VerticalAlignment="Center"
                                   Foreground="{StaticResource ProductPreviewCardComponentView.OldPrice.TextBlock.Foreground.Brush}"
                                   Style="{StaticResource Caption.TextBlock.Style}"
                                   TextDecorations="Strikethrough">
                            <Run Text="{x:Static constants:SpecialCharacters.Dollar}" /><Run Text="{Binding Product.OldPrice, Mode=OneWay}" />
                        </TextBlock>
                    </panels:SpacingStackPanel>

                    <buttons:RoundedButton Margin="0,30,0,0" Style="{StaticResource Primary.RoundedButton.Style}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Height="16"
                                  Data="M12.8649 8.1664C13.7779 8.52625 14.3794 9.40634 14.3831 10.3878C14.381 11.2088 13.9589 11.9715 13.2644 12.4094C13.4723 12.7661 13.5825 13.1712 13.584 13.584C13.5914 14.5428 13.0268 15.4139 12.1485 15.7985C11.2701 16.1831 10.2471 16.0073 9.54753 15.3516C8.84795 14.6958 8.60643 13.6863 8.93348 12.785H7.0477C7.40887 13.78 7.07458 14.8942 6.22528 15.5261C5.37597 16.158 4.21274 16.158 3.36344 15.5261C2.51413 14.8942 2.17985 13.78 2.54101 12.785H1.59812C1.15681 12.785 0.799059 12.4272 0.799059 11.9859C0.799059 11.5446 1.15681 11.1868 1.59812 11.1868H11.9859C12.4272 11.1868 12.785 10.8291 12.785 10.3878C12.785 9.94647 12.4272 9.58872 11.9859 9.58872H3.76357C3.39211 9.60144 3.06093 9.35637 2.96451 8.99742L0.982843 1.59813H0V7.77782e-06H1.59812C1.96072 -0.00158361 2.27893 0.241179 2.37321 0.591312L2.6369 1.59813H13.584C13.8259 1.59094 14.0581 1.69379 14.2153 1.8778C14.3692 2.07434 14.4224 2.33151 14.3591 2.57298L12.8649 8.1664ZM4.39483 7.9906H11.2587L12.5452 3.19625H3.06839L4.39483 7.9906ZM4.79436 14.3831C4.35305 14.3831 3.9953 14.0253 3.9953 13.584C3.9953 13.1427 4.35305 12.785 4.79436 12.785C5.23566 12.785 5.59342 13.1427 5.59342 13.584C5.59342 14.0253 5.23566 14.3831 4.79436 14.3831ZM10.3878 13.584C10.3878 14.0253 10.7455 14.3831 11.1868 14.3831C11.6281 14.3831 11.9859 14.0253 11.9859 13.584C11.9859 13.1427 11.6281 12.785 11.1868 12.785C10.7455 12.785 10.3878 13.1427 10.3878 13.584Z"
                                  Fill="#FFFFFF" />

                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       Foreground="#FFFFFF"
                                       Style="{StaticResource Button.TextBlock.Style}"
                                       Text="Add to Cart" />
                        </Grid>
                    </buttons:RoundedButton>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>