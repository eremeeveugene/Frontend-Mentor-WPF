<UserControl x:Class="FrontendMentor.ProfileCardComponent.Views.ProfileCardComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FrontendMentor.ProfileCardComponent.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="clr-namespace:FrontendMentor.Assets.Controls.Panels;assembly=FrontendMentor.Assets"
             xmlns:viewModels="clr-namespace:FrontendMentor.ProfileCardComponent.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:ProfileCardComponentViewModel}"
             x:ClassModifier="internal"
             mc:Ignorable="d">

    <Grid ClipToBounds="True">
        <Ellipse Width="976"
                 Height="976"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Opacity="0.5"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="135" />
                    <TranslateTransform X="-283" Y="-508" />
                </TransformGroup>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <LinearGradientBrush.GradientStops>
                        <GradientStop Color="#000989B4" />
                        <GradientStop Offset="1" Color="#53FFEE" />
                    </LinearGradientBrush.GradientStops>
                </LinearGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="976"
                 Height="976"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Opacity="0.25"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <RotateTransform Angle="45" />
                    <TranslateTransform X="228" Y="632" />
                </TransformGroup>
            </Ellipse.RenderTransform>
            <Ellipse.Fill>
                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                    <LinearGradientBrush.GradientStops>
                        <GradientStop Color="#000989B4" />
                        <GradientStop Offset="1" Color="#53FFEE" />
                    </LinearGradientBrush.GradientStops>
                </LinearGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel Width="350" VerticalAlignment="Center">
            <Grid>
                <StackPanel>
                    <Border Height="140"
                            Background="#41CBD3"
                            CornerRadius="15 15 0 0" />

                    <Border Height="145" Background="#FFFFFF">
                        <panels:SpacingStackPanel HorizontalAlignment="Center" Spacing="8">
                            <panels:SpacingStackPanel Margin="0,72,0,0"
                                                      Orientation="Horizontal"
                                                      Spacing="10">
                                <TextBlock Style="{StaticResource Heading.TextBlock.Style}">
                                    <Run Text="{Binding Profile.FirstName, Mode=OneWay}" />
                                    <Run Text="{Binding Profile.LastName, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Style="{StaticResource Heading.Caption.TextBlock.Style}" Text="{Binding Profile.Age}" />
                            </panels:SpacingStackPanel>

                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource Body.TextBlock.Style}"
                                       Text="{Binding Profile.Location}" />
                        </panels:SpacingStackPanel>
                    </Border>

                </StackPanel>

                <Ellipse Width="96"
                         Height="96"
                         Stroke="#FFFFFF"
                         StrokeThickness="5">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Profile.ProfileImage}" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <Border Height="1" Background="#E8E9EC" />

            <Border Padding="24"
                    Background="#FFFFFF"
                    CornerRadius="0 0 15 15">
                <panels:SpacingStackPanel HorizontalAlignment="Center"
                                          Orientation="Horizontal"
                                          Spacing="50">
                    <panels:SpacingStackPanel Spacing="5">
                        <TextBlock Style="{StaticResource Heading.TextBlock.Style}" Text="{Binding Profile.Followers, Converter={converters:NumberAbbreviationConverter}}" />

                        <TextBlock Style="{StaticResource Caption.TextBlock.Style}" Text="Followers" />
                    </panels:SpacingStackPanel>

                    <panels:SpacingStackPanel Spacing="5">
                        <TextBlock Style="{StaticResource Heading.TextBlock.Style}" Text="{Binding Profile.Likes, Converter={converters:NumberAbbreviationConverter}}" />

                        <TextBlock Style="{StaticResource Caption.TextBlock.Style}" Text="Likes" />
                    </panels:SpacingStackPanel>

                    <panels:SpacingStackPanel Spacing="5">
                        <TextBlock Style="{StaticResource Heading.TextBlock.Style}" Text="{Binding Profile.Photos, Converter={converters:NumberAbbreviationConverter}}" />

                        <TextBlock Style="{StaticResource Caption.TextBlock.Style}" Text="Photos" />
                    </panels:SpacingStackPanel>
                </panels:SpacingStackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>