<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary
            Source="pack://application:,,,/FrontendMentor.EntertainmentApp;component/Colors/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--#region EntertainmentAppWindow-->

    <SolidColorBrush x:Key="EntertainmentAppWindow.Foreground.Brush"
                     po:Freeze="True"
                     Color="{StaticResource White.Color}" />

    <SolidColorBrush x:Key="EntertainmentAppWindow.Background.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Blue.950.Color}" />

    <!--#endregion-->

</ResourceDictionary>