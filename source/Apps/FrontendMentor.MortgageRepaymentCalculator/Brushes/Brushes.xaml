<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:resourceDictionaries="clr-namespace:FrontendMentor.Assets.ResourceDictionaries;assembly=FrontendMentor.Assets">

    <ResourceDictionary.MergedDictionaries>
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.MortgageRepaymentCalculator;component/Colors/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="MortgageRepaymentCalculatorWindow.Background.Brush" po:Freeze="True" Color="{StaticResource Slate.100.Color}" />
    <SolidColorBrush x:Key="MortgageRepaymentCalculatorWindow.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.900.Color}" />

    <SolidColorBrush x:Key="MortgageRepaymentCalculatorView.Form.Background.Brush" po:Freeze="True" Color="{StaticResource White.Color}" />
    <SolidColorBrush x:Key="MortgageRepaymentCalculatorView.Heading.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.900.Color}" />
    <SolidColorBrush x:Key="MortgageRepaymentCalculatorView.Label.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.700.Color}" />
    <SolidColorBrush x:Key="MortgageRepaymentCalculatorView.Error.Foreground.Brush" po:Freeze="True" Color="{StaticResource Red.Color}" />
    <SolidColorBrush x:Key="MortgageRepaymentCalculatorView.Results.Background.Brush" po:Freeze="True" Color="{StaticResource Slate.900.Color}" />
    <SolidColorBrush x:Key="MortgageRepaymentCalculatorView.ResultsHeading.Foreground.Brush" po:Freeze="True" Color="{StaticResource White.Color}" />
    <SolidColorBrush x:Key="MortgageRepaymentCalculatorView.ResultsBody.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.300.Color}" />
    <SolidColorBrush x:Key="MortgageRepaymentCalculatorView.Summary.Background.Brush" po:Freeze="True" Color="{StaticResource Black.Transparent.Color}" />
    <SolidColorBrush x:Key="MortgageRepaymentCalculatorView.Summary.BorderBrush.Brush" po:Freeze="True" Color="{StaticResource Lime.Color}" />
    <SolidColorBrush x:Key="MortgageRepaymentCalculatorView.MonthlyRepayment.Foreground.Brush" po:Freeze="True" Color="{StaticResource Lime.Color}" />
    <SolidColorBrush x:Key="MortgageRepaymentCalculatorView.Separator.Fill.Brush" po:Freeze="True" Color="{StaticResource Slate.300.Transparent.Color}" />

    <SolidColorBrush x:Key="NumberField.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.900.Color}" />
    <SolidColorBrush x:Key="NumberField.BorderBrush.Brush" po:Freeze="True" Color="{StaticResource Slate.500.Color}" />
    <SolidColorBrush x:Key="NumberField.MouseOver.BorderBrush.Brush" po:Freeze="True" Color="{StaticResource Slate.900.Color}" />
    <SolidColorBrush x:Key="NumberField.Focused.BorderBrush.Brush" po:Freeze="True" Color="{StaticResource Lime.Color}" />
    <SolidColorBrush x:Key="NumberField.Error.BorderBrush.Brush" po:Freeze="True" Color="{StaticResource Red.Color}" />
    <SolidColorBrush x:Key="NumberField.Affix.Background.Brush" po:Freeze="True" Color="{StaticResource Slate.100.Color}" />
    <SolidColorBrush x:Key="NumberField.Affix.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.700.Color}" />
    <SolidColorBrush x:Key="NumberField.Focused.Affix.Background.Brush" po:Freeze="True" Color="{StaticResource Lime.Color}" />
    <SolidColorBrush x:Key="NumberField.Focused.Affix.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.900.Color}" />
    <SolidColorBrush x:Key="NumberField.Error.Affix.Background.Brush" po:Freeze="True" Color="{StaticResource Red.Color}" />
    <SolidColorBrush x:Key="NumberField.Error.Affix.Foreground.Brush" po:Freeze="True" Color="{StaticResource White.Color}" />
    <SolidColorBrush x:Key="NumberField.Header.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.700.Color}" />
    <SolidColorBrush x:Key="NumberField.Error.Foreground.Brush" po:Freeze="True" Color="{StaticResource Red.Color}" />

    <SolidColorBrush x:Key="MortgageTypeRadioButton.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.900.Color}" />
    <SolidColorBrush x:Key="MortgageTypeRadioButton.BorderBrush.Brush" po:Freeze="True" Color="{StaticResource Slate.500.Color}" />
    <SolidColorBrush x:Key="MortgageTypeRadioButton.Checked.BorderBrush.Brush" po:Freeze="True" Color="{StaticResource Lime.Color}" />
    <SolidColorBrush x:Key="MortgageTypeRadioButton.Checked.Background.Brush" po:Freeze="True" Color="{StaticResource Lime.Transparent.Color}" />
    <SolidColorBrush x:Key="MortgageTypeRadioButton.Indicator.Fill.Brush" po:Freeze="True" Color="{StaticResource Slate.700.Color}" />
    <SolidColorBrush x:Key="MortgageTypeRadioButton.Checked.Indicator.Fill.Brush" po:Freeze="True" Color="{StaticResource Lime.Color}" />

    <SolidColorBrush x:Key="CalculateButton.Background.Brush" po:Freeze="True" Color="{StaticResource Lime.Color}" />
    <SolidColorBrush x:Key="CalculateButton.MouseOver.Background.Brush" po:Freeze="True" Color="{StaticResource Lime.Light.Color}" />
    <SolidColorBrush x:Key="CalculateButton.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.900.Color}" />

    <SolidColorBrush x:Key="LinkButton.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.700.Color}" />
    <SolidColorBrush x:Key="LinkButton.MouseOver.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.900.Color}" />

    <SolidColorBrush x:Key="MortgageResultsImage.Foreground.Brush" po:Freeze="True" Color="{StaticResource White.Color}" />
    <SolidColorBrush x:Key="MortgageResultsImage.Secondary.Foreground.Brush" po:Freeze="True" Color="{StaticResource Slate.900.Color}" />
    <SolidColorBrush x:Key="MortgageResultsImage.Accent.Brush" po:Freeze="True" Color="{StaticResource Lime.Color}" />

</ResourceDictionary>