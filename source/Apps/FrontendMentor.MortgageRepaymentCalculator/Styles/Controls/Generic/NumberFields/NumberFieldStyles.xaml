<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:numberFields="clr-namespace:FrontendMentor.MortgageRepaymentCalculator.Controls.NumberFields"
                    xmlns:resourceDictionaries="clr-namespace:FrontendMentor.Assets.ResourceDictionaries;assembly=FrontendMentor.Assets">

    <ResourceDictionary.MergedDictionaries>
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.MortgageRepaymentCalculator;component/Brushes/Brushes.xaml" />
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.MortgageRepaymentCalculator;component/Styles/Controls/Custom/TextBlocks/TextBlockStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type numberFields:NumberField}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource NumberField.BorderBrush.Brush}" />
        <Setter Property="CaretBrush" Value="{StaticResource NumberField.Foreground.Brush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource NumberField.Foreground.Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type numberFields:NumberField}">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,12"
                                   Foreground="{StaticResource NumberField.Header.Foreground.Brush}"
                                   Style="{StaticResource Preset4.TextBlock.Style}"
                                   Text="{TemplateBinding Header}" />

                        <Border x:Name="FieldBorder"
                                Height="48"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <DockPanel>
                                <Border x:Name="AffixBorder"
                                        Padding="16,0"
                                        Background="{StaticResource NumberField.Affix.Background.Brush}"
                                        CornerRadius="3,0,0,3"
                                        DockPanel.Dock="{TemplateBinding AffixPlacement}">
                                    <TextBlock x:Name="AffixTextBlock"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource NumberField.Affix.Foreground.Brush}"
                                               Style="{StaticResource Preset3.TextBlock.Style}"
                                               Text="{TemplateBinding Affix}" />
                                </Border>

                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="14,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </DockPanel>
                        </Border>

                        <TextBlock x:Name="ErrorTextBlock"
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource NumberField.Error.Foreground.Brush}"
                                   Style="{StaticResource Preset5.TextBlock.Style}"
                                   Text="{TemplateBinding Error}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AffixPlacement" Value="Right">
                            <Setter TargetName="AffixBorder" Property="CornerRadius" Value="0,3,3,0" />
                        </Trigger>
                        <Trigger SourceName="FieldBorder" Property="IsMouseOver" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource NumberField.MouseOver.BorderBrush.Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource NumberField.Focused.BorderBrush.Brush}" />
                            <Setter TargetName="AffixBorder" Property="Background" Value="{StaticResource NumberField.Focused.Affix.Background.Brush}" />
                            <Setter TargetName="AffixTextBlock" Property="Foreground" Value="{StaticResource NumberField.Focused.Affix.Foreground.Brush}" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="FieldBorder" Property="BorderBrush" Value="{StaticResource NumberField.Error.BorderBrush.Brush}" />
                            <Setter TargetName="AffixBorder" Property="Background" Value="{StaticResource NumberField.Error.Affix.Background.Brush}" />
                            <Setter TargetName="AffixTextBlock" Property="Foreground" Value="{StaticResource NumberField.Error.Affix.Foreground.Brush}" />
                            <Setter TargetName="ErrorTextBlock" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>