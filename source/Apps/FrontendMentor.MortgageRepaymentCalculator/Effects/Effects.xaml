<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:resourceDictionaries="clr-namespace:FrontendMentor.Assets.ResourceDictionaries;assembly=FrontendMentor.Assets">

    <ResourceDictionary.MergedDictionaries>
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.MortgageRepaymentCalculator;component/Colors/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DropShadowEffect x:Key="MortgageRepaymentCalculatorView.Card.DropShadowEffect"
                      po:Freeze="True"
                      BlurRadius="64"
                      Direction="270"
                      Opacity="0.1"
                      ShadowDepth="32"
                      Color="{StaticResource Slate.900.Color}" />

</ResourceDictionary>