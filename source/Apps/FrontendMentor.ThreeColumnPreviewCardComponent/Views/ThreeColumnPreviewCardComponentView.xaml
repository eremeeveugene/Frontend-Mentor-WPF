<UserControl x:Class="FrontendMentor.ThreeColumnPreviewCardComponent.Views.ThreeColumnPreviewCardComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cards="clr-namespace:FrontendMentor.ThreeColumnPreviewCardComponent.Controls.Cards"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:FrontendMentor.ThreeColumnPreviewCardComponent.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:ThreeColumnPreviewCardComponentViewModel}"
             x:ClassModifier="internal"
             mc:Ignorable="d">

    <Grid Width="920"
          Height="500"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <cards:PreviewCard Grid.Column="0"
                           LearnMoreCommand="{Binding LearnMoreAboutSedanCommand}"
                           Style="{StaticResource Sedan.PreviewCard.Style}" />

        <cards:PreviewCard Grid.Column="1"
                           LearnMoreCommand="{Binding LearnMoreAboutSuvCommand}"
                           Style="{StaticResource Suv.PreviewCard.Style}" />

        <cards:PreviewCard Grid.Column="2"
                           LearnMoreCommand="{Binding LearnMoreAboutLuxuryCommand}"
                           Style="{StaticResource Luxury.PreviewCard.Style}" />
    </Grid>

</UserControl>