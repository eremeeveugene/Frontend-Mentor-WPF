<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:constants="clr-namespace:FrontendMentor.Assets.Constants;assembly=FrontendMentor.Assets"
                    xmlns:helpers="clr-namespace:FrontendMentor.Assets.Helpers;assembly=FrontendMentor.Assets"
                    xmlns:resourceDictionaries="clr-namespace:FrontendMentor.Assets.ResourceDictionaries;assembly=FrontendMentor.Assets">

    <ResourceDictionary.MergedDictionaries>
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.BlogPreviewCard;component/Colors/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Storyboard x:Key="BlogPreviewCard.Normal.Storyboard" x:Shared="False">
        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PART_TitleTextBlock" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
            <DiscreteColorKeyFrame Value="{StaticResource Grey.950.Color}" />
        </ColorAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="BlogPreviewCard.MouseOver.Storyboard" x:Shared="False">
        <ColorAnimationUsingKeyFrames Storyboard.TargetName="PART_TitleTextBlock" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
            <DiscreteColorKeyFrame Value="{StaticResource Yellow.Color}" />
        </ColorAnimationUsingKeyFrames>
    </Storyboard>

    <Storyboard x:Key="BlogPreviewCard.ToNormal.Storyboard" x:Shared="False">
        <ColorAnimation EasingFunction="{x:Static helpers:EasingFunctionsHelper.GenericEasingFunction}"
                        Storyboard.TargetName="PART_TitleTextBlock"
                        Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                        To="{StaticResource Grey.950.Color}"
                        Duration="{x:Static constants:AnimationConstants.GenericAnimationDuration}" />
    </Storyboard>

    <Storyboard x:Key="BlogPreviewCard.ToMouseOver.Storyboard" x:Shared="False">
        <ColorAnimation EasingFunction="{x:Static helpers:EasingFunctionsHelper.GenericEasingFunction}"
                        Storyboard.TargetName="PART_TitleTextBlock"
                        Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)"
                        To="{StaticResource Yellow.Color}"
                        Duration="{x:Static constants:AnimationConstants.GenericAnimationDuration}" />
    </Storyboard>

</ResourceDictionary>