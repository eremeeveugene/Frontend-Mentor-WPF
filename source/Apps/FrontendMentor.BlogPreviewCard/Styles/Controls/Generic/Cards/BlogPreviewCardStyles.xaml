<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cards="clr-namespace:FrontendMentor.BlogPreviewCard.Controls.Cards"
                    xmlns:constants="clr-namespace:FrontendMentor.Core.Constants;assembly=FrontendMentor.Core"
                    xmlns:properties="clr-namespace:FrontendMentor.BlogPreviewCard.Properties"
                    xmlns:resourceDictionaries="clr-namespace:FrontendMentor.Assets.ResourceDictionaries;assembly=FrontendMentor.Assets">

    <ResourceDictionary.MergedDictionaries>
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.BlogPreviewCard;component/Brushes/Brushes.xaml" />
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.BlogPreviewCard;component/Effects/Effects.xaml" />
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.BlogPreviewCard;component/Storyboards/Storyboards.xaml" />
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.BlogPreviewCard;component/Styles/Controls/Custom/TextBlocks/TextBlockStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="BlogPreviewCardView.CategoryBorder.Style" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BlogPreviewCardView.CategoryBorder.Background.Brush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,2,12,6" />
    </Style>

    <ControlTemplate x:Key="BlogPreviewCard.Template" TargetType="{x:Type cards:BlogPreviewCard}">
        <Border Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <StackPanel>
                <Rectangle Height="200"
                           RadiusX="10"
                           RadiusY="10">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding Blog.BlogImage, RelativeSource={RelativeSource TemplatedParent}}" Stretch="Fill" />
                    </Rectangle.Fill>
                </Rectangle>

                <StackPanel Margin="0,25,0,0">
                    <Border Style="{StaticResource BlogPreviewCardView.CategoryBorder.Style}">
                        <TextBlock Style="{StaticResource Body.S.Bold.TextBlock.Style}" Text="{Binding Blog.Category, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>

                    <TextBlock Margin="0,9,0,0" Style="{StaticResource Body.S.Regular.TextBlock.Style}">
                        <Run Text="{x:Static properties:Resources.BlogPreviewCard_PublishedTextBlock_Text}" />
                        <Run Text="{Binding Blog.PublishedDate, Mode=OneWay, StringFormat={x:Static constants:DateTimeFormatConstants.DayMonthAbbrYear}, RelativeSource={RelativeSource TemplatedParent}}" />
                    </TextBlock>

                    <TextBlock x:Name="PART_TitleTextBlock"
                               Margin="0,11,0,0"
                               Style="{StaticResource Heading.TextBlock.Style}"
                               Text="{Binding Blog.Title, RelativeSource={RelativeSource TemplatedParent}}" />

                    <TextBlock Margin="0,14,0,0"
                               Foreground="{StaticResource BlogPreviewCardView.AuthorTextBlock.Foreground.Brush}"
                               Style="{StaticResource Body.M.TextBlock.Style}"
                               Text="{Binding Blog.Description, RelativeSource={RelativeSource TemplatedParent}}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Margin="0,25,0,0" Orientation="Horizontal">
                    <Ellipse Width="32" Height="32">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Blog.BlogAuthor.UserImage, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <TextBlock Margin="12,0,0,2"
                               VerticalAlignment="Center"
                               Style="{StaticResource Body.S.Bold.TextBlock.Style}">
                        <Run Text="{Binding Blog.BlogAuthor.FirstName, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Run Text="{Binding Blog.BlogAuthor.LastName, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" Storyboard="{StaticResource BlogPreviewCard.Normal.Storyboard}" />
                    <VisualState x:Name="MouseOver" Storyboard="{StaticResource BlogPreviewCard.MouseOver.Storyboard}" />
                    <VisualStateGroup.Transitions>
                        <VisualTransition Storyboard="{StaticResource BlogPreviewCard.ToNormal.Storyboard}" To="Normal" />
                        <VisualTransition Storyboard="{StaticResource BlogPreviewCard.ToMouseOver.Storyboard}" To="MouseOver" />
                    </VisualStateGroup.Transitions>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Border>
    </ControlTemplate>

    <Style TargetType="{x:Type cards:BlogPreviewCard}">
        <Setter Property="Background" Value="{StaticResource BlogPreviewCardView.RootBorder.Background.Brush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BlogPreviewCardView.RootBorder.Border.Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Effect" Value="{StaticResource BlogPreviewCardView.RootBorder.DropShadow.Effect}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Padding" Value="23" />
        <Setter Property="Template" Value="{StaticResource BlogPreviewCard.Template}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Width" Value="384" />
    </Style>

</ResourceDictionary>