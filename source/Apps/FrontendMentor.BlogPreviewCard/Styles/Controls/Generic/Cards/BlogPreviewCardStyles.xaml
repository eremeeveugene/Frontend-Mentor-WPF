<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cards="clr-namespace:FrontendMentor.BlogPreviewCard.Controls.Cards"
                    xmlns:coreConstants="clr-namespace:FrontendMentor.Core.Constants;assembly=FrontendMentor.Core"
                    xmlns:panels="clr-namespace:FrontendMentor.Assets.Controls.Panels;assembly=FrontendMentor.Assets"
                    xmlns:properties="clr-namespace:FrontendMentor.BlogPreviewCard.Properties"
                    xmlns:resourceDictionaries="clr-namespace:FrontendMentor.Assets.ResourceDictionaries;assembly=FrontendMentor.Assets">

    <ResourceDictionary.MergedDictionaries>
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.BlogPreviewCard;component/Brushes/Brushes.xaml" />
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.BlogPreviewCard;component/Effects/Effects.xaml" />
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.BlogPreviewCard;component/Styles/Controls/Custom/TextBlocks/TextBlockStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="BlogPreviewCard.CategoryBorder.Style" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource BlogPreviewCard.CategoryBorder.Background.Brush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,2,12,6" />
    </Style>

    <ControlTemplate x:Key="BlogPreviewCard.Template" TargetType="{x:Type cards:BlogPreviewCard}">
        <Border Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
            <panels:SpacingStackPanel Spacing="24">
                <Rectangle Height="200"
                           RadiusX="10"
                           RadiusY="10">
                    <Rectangle.Fill>
                        <ImageBrush ImageSource="{Binding Blog.BlogImage, RelativeSource={RelativeSource TemplatedParent}}" Stretch="Fill" />
                    </Rectangle.Fill>
                </Rectangle>

                <panels:SpacingStackPanel Spacing="12">
                    <Border HorizontalAlignment="Left" Style="{StaticResource BlogPreviewCard.CategoryBorder.Style}">
                        <TextBlock Style="{StaticResource Body.S.Bold.TextBlock.Style}" Text="{Binding Blog.Category, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>

                    <TextBlock Style="{StaticResource Body.S.Regular.TextBlock.Style}">
                        <Run Text="{x:Static properties:Resources.BlogPreviewCard_PublishedTextBlock_Text}" />
                        <Run Text="{Binding Blog.PublishedDate, Mode=OneWay, StringFormat={x:Static coreConstants:DateTimeFormatConstants.DayMonthAbbrYear}, RelativeSource={RelativeSource TemplatedParent}}" />
                    </TextBlock>

                    <TextBlock x:Name="PART_TitleTextBlock"
                               Foreground="{StaticResource BlogPreviewCard.TitleTextBlock.Foreground.Brush}"
                               Style="{StaticResource Heading.TextBlock.Style}"
                               Text="{Binding Blog.Title, RelativeSource={RelativeSource TemplatedParent}}" />

                    <TextBlock Foreground="{StaticResource BlogPreviewCard.AuthorTextBlock.Foreground.Brush}"
                               Style="{StaticResource Body.M.TextBlock.Style}"
                               Text="{Binding Blog.Description, RelativeSource={RelativeSource TemplatedParent}}"
                               TextWrapping="Wrap" />
                </panels:SpacingStackPanel>

                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="32" Height="32">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Blog.BlogAuthor.UserImage, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Ellipse.Fill>
                    </Ellipse>

                    <TextBlock Margin="12,0,0,2"
                               VerticalAlignment="Center"
                               Style="{StaticResource Body.S.Bold.TextBlock.Style}">
                        <Run Text="{Binding Blog.BlogAuthor.FirstName, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Run Text="{Binding Blog.BlogAuthor.LastName, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    </TextBlock>
                </StackPanel>
            </panels:SpacingStackPanel>

            <!--<VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Storyboard>
                            <Storyboard>
                                <ColorAnimationUsingKeyFrames Storyboard.TargetName="PART_TitleTextBlock" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                                    <DiscreteColorKeyFrame Value="{StaticResource Grey.950.Color}" />
                                </ColorAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState.Storyboard>
                    </VisualState>
                    <VisualState x:Name="MouseOver">
                        <VisualState.Storyboard>
                            <Storyboard>
                                <ColorAnimationUsingKeyFrames Storyboard.TargetName="PART_TitleTextBlock" Storyboard.TargetProperty="(TextBlock.Foreground).(SolidColorBrush.Color)">
                                    <DiscreteColorKeyFrame Value="{StaticResource Yellow.Color}" />
                                </ColorAnimationUsingKeyFrames>
                            </Storyboard>
                        </VisualState.Storyboard>
                    </VisualState>
                    <VisualStateGroup.Transitions>
                        <VisualTransition To="Normal">
                            <VisualTransition.Storyboard>
