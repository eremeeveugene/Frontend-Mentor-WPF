<views:ViewBase x:Class="FrontendMentor.QrCodeComponent.Views.QrCodeComponent.QrCodeComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:viewModels="clr-namespace:FrontendMentor.QrCodeComponent.ViewModels.QrCodeComponent"
             xmlns:views="clr-namespace:FrontendMentor.Core.Views;assembly=FrontendMentor.Core"
             d:DataContext="{d:DesignInstance viewModels:IQrCodeComponentViewModel}"
             x:ClassModifier="internal"
             mc:Ignorable="d">

    <Grid Width="320"
          VerticalAlignment="Center">
        <Border Background="{StaticResource QrCodeComponentView.QrCodeOuterBorder.Background.Brush}"
                CornerRadius="20"
                Effect="{StaticResource QrCodeComponentView.QrCodeOuterBorder.DropShadowEffect}" />

        <StackPanel Margin="16,16,16,40">
            <Grid Height="288">
                <Rectangle Fill="{StaticResource QrCodeComponentView.QrCodeInnerRectangle.Background.Brush}"
                           RadiusX="10"
                           RadiusY="10" />

                <Canvas>
                    <Canvas.Clip>
                        <RectangleGeometry po:Freeze="True"
                                           RadiusX="10"
                                           RadiusY="10"
                                           Rect="0,0,288,288" />
                    </Canvas.Clip>

                    <Ellipse Canvas.Right="91.5"
                             Canvas.Bottom="124.5"
                             Width="328"
                             Height="328"
                             Fill="{StaticResource QrCodeComponentView.QrCodeEllipse.Fill.Brush}" />

                    <Ellipse Canvas.Left="131.5"
                             Canvas.Top="204.5"
                             Width="270"
                             Height="270"
                             Fill="{StaticResource QrCodeComponentView.QrCodeEllipse.Fill.Brush}" />
                </Canvas>

                <Image Width="160"
                       Height="160"
                       Source="{StaticResource QrCode.Image}" />
            </Grid>

            <StackPanel Margin="16,24,16,0">
                <TextBlock Style="{StaticResource Heading.TextBlock.Style}"
                           Text="{Binding QrCode.Heading}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <TextBlock Margin="0,16,0,0"
                           Foreground="{StaticResource QrCodeComponentView.BodyTextBlock.Foreground.Brush}"
                           Style="{StaticResource Body.TextBlock.Style}"
                           Text="{Binding QrCode.Caption}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </StackPanel>
    </Grid>
</views:ViewBase>