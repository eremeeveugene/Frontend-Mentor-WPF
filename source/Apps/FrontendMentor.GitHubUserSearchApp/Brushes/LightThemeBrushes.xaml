<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:resourceDictionaries="clr-namespace:FrontendMentor.Assets.ResourceDictionaries;assembly=FrontendMentor.Assets">

    <ResourceDictionary.MergedDictionaries>
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.GitHubUserSearchApp;component/Colors/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--#region GitHubUserSearchAppWindow-->

    <SolidColorBrush x:Key="GitHubUserSearchAppWindow.Background.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Ghost.White.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppWindow.Foreground.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Gunmetal.Color}" />

    <!--#endregion-->

    <!--#region GitHubUserSearchAppView-->

    <SolidColorBrush x:Key="GitHubUserSearchAppView.Surface.Background.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Iron.White.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppView.Stats.Background.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Ghost.White.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppView.Heading.Foreground.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Gunmetal.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppView.Body.Foreground.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Queen.Blue.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppView.Muted.Foreground.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Slate.Gray.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppView.ThemeSwitchButton.MouseOver.Foreground.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Gunmetal.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppView.Accent.Foreground.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Azure.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppView.NoResults.Foreground.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Red.Orange.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppView.SearchButton.Background.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Azure.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppView.SearchButton.MouseOver.Background.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Light.Azure.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppView.SearchButton.Foreground.Brush"
                     po:Freeze="True"
                     Color="{StaticResource White.Color}" />

    <!--#endregion-->

</ResourceDictionary>