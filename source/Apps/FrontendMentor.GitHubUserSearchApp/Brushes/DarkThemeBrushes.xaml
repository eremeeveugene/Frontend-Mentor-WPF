<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:resourceDictionaries="clr-namespace:FrontendMentor.Assets.ResourceDictionaries;assembly=FrontendMentor.Assets">

    <ResourceDictionary.MergedDictionaries>
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.GitHubUserSearchApp;component/Colors/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--#region GitHubUserSearchAppWindow-->

    <SolidColorBrush x:Key="GitHubUserSearchAppWindow.Background.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Dark.Gunmetal.Color}" />

    <SolidColorBrush x:Key="GitHubUserSearchAppWindow.Foreground.Brush}"
                     po:Freeze="True"
                     Color="{StaticResource White.Color}" />

    <!--#endregion-->

</ResourceDictionary>