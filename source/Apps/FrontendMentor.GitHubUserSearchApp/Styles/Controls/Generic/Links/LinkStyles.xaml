<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:links="clr-namespace:FrontendMentor.GitHubUserSearchApp.Controls.Links"
                    xmlns:properties="clr-namespace:FrontendMentor.GitHubUserSearchApp.Properties">

    <ControlTemplate x:Key="LinkTemplate" TargetType="{x:Type links:Link}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Path Grid.Column="0"
                  Width="20"
                  Data="{TemplateBinding Geometry}"
                  Fill="{DynamicResource GitHubUserSearchAppView.Body.Foreground.Brush}" />

            <TextBlock Grid.Column="1"
                       Margin="16,0,0,0"
                       Foreground="{DynamicResource GitHubUserSearchAppView.Body.Foreground.Brush}"
                       Text="{Binding Source, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue={x:Static properties:Resources.Link_NotAvailable_Text}}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </ControlTemplate>

    <Style TargetType="{x:Type links:Link}">
        <Setter Property="Template" Value="{StaticResource LinkTemplate}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                <Setter Property="Opacity" Value="0.5" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>