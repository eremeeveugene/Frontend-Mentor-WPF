<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:assetsWindows="clr-namespace:FrontendMentor.Assets.Controls.Windows;assembly=FrontendMentor.Assets"
                    xmlns:properties="clr-namespace:FrontendMentor.GitHubUserSearchApp.Properties"
                    xmlns:resourceDictionaries="clr-namespace:FrontendMentor.Assets.ResourceDictionaries;assembly=FrontendMentor.Assets"
                    xmlns:windows="clr-namespace:FrontendMentor.GitHubUserSearchApp.Controls.Windows">

    <ResourceDictionary.MergedDictionaries>
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.Assets;component/Styles/Controls/Generic/Windows/FrontendMentorWindowStyles.xaml" />
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.GitHubUserSearchApp;component/Fonts/Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource {x:Type assetsWindows:FrontendMentorWindow}}" TargetType="{x:Type windows:GitHubUserSearchAppWindow}">
        <Setter Property="Background" Value="{DynamicResource GitHubUserSearchAppWindow.Background.Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource SpaceMono.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource GitHubUserSearchAppWindow.Foreground.Brush}" />
        <Setter Property="MinHeight" Value="900" />
        <Setter Property="MinWidth" Value="1440" />
        <Setter Property="Title" Value="{x:Static properties:Resources.GitHubUserSearchAppWindow_Title}" />
    </Style>

</ResourceDictionary>