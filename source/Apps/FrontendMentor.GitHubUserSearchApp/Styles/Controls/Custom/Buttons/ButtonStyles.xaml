<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Search.Button.Style" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource GitHubUserSearchAppView.SearchButton.Background.Brush}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource GitHubUserSearchAppView.SearchButton.Foreground.Brush}" />
        <Setter Property="Height" Value="50" />
        <Setter Property="MinWidth" Value="106" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource GitHubUserSearchAppView.SearchButton.MouseOver.Background.Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ThemeSwitch.Button.Style" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource GitHubUserSearchAppView.Muted.Foreground.Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource GitHubUserSearchAppView.ThemeSwitchButton.MouseOver.Foreground.Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>