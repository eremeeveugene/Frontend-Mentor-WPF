<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="H1.TextBlock.Style" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Heading.S.TextBlock.Style" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="Black" />
    </Style>

    <Style x:Key="Heading.M.TextBlock.Style"
           BasedOn="{StaticResource Heading.S.TextBlock.Style}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="Heading.L.TextBlock.Style"
           BasedOn="{StaticResource Heading.M.TextBlock.Style}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="Body.TextBlock.Style" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="Body.Multiline.TextBlock.Style"
           BasedOn="{StaticResource Body.TextBlock.Style}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="LineHeight" Value="26" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>