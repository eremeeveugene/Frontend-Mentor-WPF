<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:properties="clr-namespace:FrontendMentor.GitHubUserSearchApp.Properties">

    <Style x:Key="Search.TextBox.Style" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource GitHubUserSearchAppView.Accent.Foreground.Brush}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource GitHubUserSearchAppView.Heading.Foreground.Brush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Grid>
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />

                        <TextBlock x:Name="PlaceholderTextBlock"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource GitHubUserSearchAppView.Body.Foreground.Brush}"
                                   IsHitTestVisible="False"
                                   Text="{x:Static properties:Resources.GitHubUserSearchAppView_SearchTextBox_Placeholder}"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderTextBlock" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>