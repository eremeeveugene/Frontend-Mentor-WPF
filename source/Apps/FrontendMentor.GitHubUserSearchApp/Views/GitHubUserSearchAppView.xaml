<UserControl x:Class="FrontendMentor.GitHubUserSearchApp.Views.GitHubUserSearchAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:links="clr-namespace:FrontendMentor.GitHubUserSearchApp.Controls.Links"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="clr-namespace:FrontendMentor.Assets.Controls.Panels;assembly=FrontendMentor.Assets"
             xmlns:viewModels="clr-namespace:FrontendMentor.GitHubUserSearchApp.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:GitHubUserSearchAppViewModel}"
             x:ClassModifier="internal"
             mc:Ignorable="d">

    <Grid Width="730"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
        <StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Style="{StaticResource H1.TextBlock.Style}"
                           Text="devfinder" />

                <Button HorizontalAlignment="Right"
                        Command="{Binding SwitchThemeCommand}"
                        DockPanel.Dock="Right">
                    <TextBlock Text="Dark" />
                </Button>
            </DockPanel>

            <Border Margin="0,36,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding Username}" />

                    <Button Grid.Column="1" Command="{Binding SearchUserCommand}">
                        <TextBlock Text="Search" />
                    </Button>
                </Grid>
            </Border>

            <Border Margin="0,24,0,0"
                    Padding="48"
                    Background="#FEFEFE"
                    CornerRadius="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" />

                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Style="{StaticResource H1.TextBlock.Style}"
                                       Text="{Binding GitHubUser.Name}" />

                            <TextBlock HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"
                                       Style="{StaticResource Body.TextBlock.Style}">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="#697C9A" />
                                </TextBlock.Foreground>
                                <Run Text="Joined" />
                                <Run Text="{Binding GitHubUser.DateJoined, StringFormat='{}{0:dd MMM yyyy}', Mode=OneWay, FallbackValue='This profile has no bio'}" />
                            </TextBlock>
                        </DockPanel>

                        <TextBlock Margin="0,2,0,0" Style="{StaticResource H3.TextBlock.Style}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#0079FF" />
                            </TextBlock.Foreground>

                            <Run Text="@" /><Run Text="{Binding GitHubUser.Login, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Margin="0,20,0,0"
                                   Style="{StaticResource Body.TextBlock.Style}"
                                   Text="{Binding GitHubUser.Bio}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#4B6A9B" />
                            </TextBlock.Foreground>
                        </TextBlock>

                        <Border Margin="0,32,0,0"
                                Padding="32,15,32,17"
                                Background="#F6F8FF "
                                CornerRadius="10">
                            <panels:SpacingStackPanel Spacing="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Style="{StaticResource H4.TextBlock.Style}"
                                               Text="Repos">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#4B6A9B" />
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Style="{StaticResource H4.TextBlock.Style}"
                                               Text="Followers">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#4B6A9B" />
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="2"
                                               Style="{StaticResource H4.TextBlock.Style}"
                                               Text="Following">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#4B6A9B" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource H2.TextBlock.Style}"
                                               Text="{Binding GitHubUser.Repos}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#2B3442" />
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource H2.TextBlock.Style}"
                                               Text="{Binding GitHubUser.Followers}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#2B3442" />
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource H2.TextBlock.Style}"
                                               Text="{Binding GitHubUser.Following}">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#2B3442" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Grid>
                            </panels:SpacingStackPanel>
                        </Border>

                        <panels:SpacingStackPanel Margin="0,37,0,0" Spacing="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

