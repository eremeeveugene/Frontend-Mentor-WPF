<UserControl x:Class="FrontendMentor.GitHubUserSearchApp.Views.GitHubUserSearchAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="clr-namespace:FrontendMentor.Assets.Controls.Panels;assembly=FrontendMentor.Assets"
             xmlns:viewModels="clr-namespace:FrontendMentor.GitHubUserSearchApp.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:GitHubUserSearchAppViewModel}"
             x:ClassModifier="internal"
             mc:Ignorable="d">

    <Grid Width="730"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
        <StackPanel>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left"
                           Style="{StaticResource H1.TextBlock.Style}"
                           Text="devfinder" />

                <Button HorizontalAlignment="Right"
                        Command="{Binding SwitchThemeCommand}"
                        DockPanel.Dock="Right">
                    <TextBlock Text="Dark" />
                </Button>
            </DockPanel>

            <Border Margin="0,36,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding Username}" />

                    <Button Grid.Column="1" Command="{Binding SearchUserCommand}">
                        <TextBlock Text="Search" />
                    </Button>
                </Grid>
            </Border>

            <Border Margin="0,24,0,0"
                    Padding="48"
                    Background="#FEFEFE"
                    CornerRadius="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0" />

                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left"
                                       Style="{StaticResource H1.TextBlock.Style}"
                                       Text="{Binding GitHubUser.Name}" />

                            <TextBlock HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"
                                       Style="{StaticResource Body.TextBlock.Style}"
                                       Text="Joined 25 Jan 2011">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="#697C9A" />
                                </TextBlock.Foreground>
                            </TextBlock>
                        </DockPanel>

                        <TextBlock Style="{StaticResource H3.TextBlock.Style}">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#0079FF" />
                            </TextBlock.Foreground>

                            <Run Text="@" /><Run Text="{Binding GitHubUser.Login, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock Style="{StaticResource Body.TextBlock.Style}" Text="Lorem ipsum dolor sit amet, consectetuer adipiscing elit. Donec odio. Quisque volutpat mattis eros.">
                            <TextBlock.Foreground>
                                <SolidColorBrush Color="#4B6A9B" />
                            </TextBlock.Foreground>
                        </TextBlock>

                        <Border Padding="32,15,32,17"
                                Background="#F6F8FF "
                                CornerRadius="10">
                            <panels:SpacingStackPanel Spacing="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               Style="{StaticResource H4.TextBlock.Style}"
                                               Text="Repos">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#4B6A9B" />
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               Style="{StaticResource H4.TextBlock.Style}"
                                               Text="Followers">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#4B6A9B" />
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="2"
                                               Style="{StaticResource H4.TextBlock.Style}"
                                               Text="Following">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#4B6A9B" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Grid>

                                <Grid Margin="0,1,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Style="{StaticResource H2.TextBlock.Style}"
                                               Text="8">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#2B3442" />
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource H2.TextBlock.Style}"
                                               Text="3938">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#2B3442" />
                                        </TextBlock.Foreground>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource H2.TextBlock.Style}"
                                               Text="9">
                                        <TextBlock.Foreground>
                                            <SolidColorBrush Color="#2B3442" />
                                        </TextBlock.Foreground>
                                    </TextBlock>
                                </Grid>
                            </panels:SpacingStackPanel>
                        </Border>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="San Francisco" />

                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       Text="https://github.blog" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       Text="Not Available" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="1"
                                       Text="@github" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>

</UserControl>
