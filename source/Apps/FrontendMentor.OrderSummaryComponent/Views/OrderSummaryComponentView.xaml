<UserControl x:Class="FrontendMentor.OrderSummaryComponent.Views.OrderSummaryComponentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:FrontendMentor.Assets.Controls.Icons;assembly=FrontendMentor.Assets"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:properties="clr-namespace:FrontendMentor.OrderSummaryComponent.Properties"
             xmlns:viewModels="clr-namespace:FrontendMentor.OrderSummaryComponent.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:OrderSummaryComponentViewModel}"
             x:ClassModifier="internal"
             mc:Ignorable="d">

    <Grid>
        <icons:Icon VerticalAlignment="Top"
                    Data="{StaticResource Wave.Geometry}"
                    Fill="{StaticResource OrderSummaryComponentView.WaveIcon.Fill.Brush}" />

        <Grid Width="450" VerticalAlignment="Center">
            <Rectangle Margin="20"
                       Fill="White"
                       RadiusX="20"
                       RadiusY="20">
                <Rectangle.RenderTransform>
                    <TranslateTransform Y="-20" />
                </Rectangle.RenderTransform>
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="40"
                                      Direction="270"
                                      Opacity="0.13"
                                      ShadowDepth="60"
                                      Color="#0D30BD" />
                </Rectangle.Effect>
            </Rectangle>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Height="220"
                        Background="{StaticResource OrderSummaryComponentView.Card.HeaderBorder.Background.Brush}"
                        ClipToBounds="True"
                        CornerRadius="20 20 0 0">
                    <Grid>
                        <icons:Icon HorizontalAlignment="Left"
                                    Data="{StaticResource City.Geometry}"
                                    Fill="{StaticResource OrderSummaryComponentView.Card.Header.CityIcon.Fill.Brush}">
                            <icons:Icon.RenderTransform>
                                <TranslateTransform X="-8" Y="46" />
                            </icons:Icon.RenderTransform>
                        </icons:Icon>

                        <icons:Icon HorizontalAlignment="Left"
                                    Data="{StaticResource City.Geometry}"
                                    Fill="{StaticResource OrderSummaryComponentView.Card.Header.CityIcon.Fill.Brush}">
                            <icons:Icon.RenderTransform>
                                <TranslateTransform X="196" Y="82" />
                            </icons:Icon.RenderTransform>
                        </icons:Icon>

                        <Image HorizontalAlignment="Left"
                               Source="{StaticResource MusicFlatLine.Image}"
                               Stretch="Uniform">
                            <Image.RenderTransform>
                                <TranslateTransform X="34.54" Y="19" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Padding="48,45,48,48"
                        Background="{StaticResource OrderSummaryComponentView.Card.BodyBorder.Background.Brush}"
                        CornerRadius="0 0 20 20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading.L.TextBlock.Style}" Text="{x:Static properties:Resources.OrderSummaryComponentView_OrderSummaryTextBlock_Text}" />

                        <TextBlock Margin="0,17,0,0"
                                   Foreground="{StaticResource OrderSummaryComponentView.Card.BodyTextBlock.Foreground.Brush}"
                                   Style="{StaticResource Body.TextBlock.Style}"
                                   Text="{x:Static properties:Resources.OrderSummaryComponentView_BodyTextBlock_Text}"
                                   TextAlignment="Center" />

                        <Border Margin="0,20,0,0"
                                Padding="24,25"
                                Background="{StaticResource OrderSummaryComponentView.Card.AnnualPlanBorder.Background.Brush}"
                                CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Width="48"
                                      Height="48">
                                    <Ellipse Grid.Column="0" Fill="{StaticResource OrderSummaryComponentView.Card.AnnualPlanMusicIconEllipse.Fill.Brush}" />

                                    <icons:Icon Height="18"
                                                Data="{StaticResource Music.Geometry}"
                                                Fill="{StaticResource OrderSummaryComponentView.Card.AnnualPlanMusicIcon.Fill.Brush}" />
                                </Grid>

                                <Grid Grid.Column="1" Margin="20,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Heading.M.TextBlock.Style}" Text="{x:Static properties:Resources.OrderSummaryComponentView_AnnualPlanTextBlock_Text}" />

                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="16"
                                                   FontWeight="Medium"
                                                   Foreground="#717FA6"
                                                   Text="$59.99/year" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#382AE1"
                                               Text="Change">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="TextDecorations" Value="{x:Static TextDecorations.Underline}" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextDecorations" Value="{x:Null}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <Hyperlink />
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <Button Margin="0,32,0,0" Content="Proceed to Payment">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Background" Value="#382AE1" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="20"
                                                              Direction="270"
                                                              Opacity="0.15"
                                                              ShadowDepth="20"
                                                              Color="#382AE1" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Height" Value="50" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="15"
                                                               FontWeight="Black"
                                                               Foreground="#FFFFFF"
                                                               Text="Proceed to Payment"
                                                               TextAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#766CF1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Margin="0,32,0,0"
                                HorizontalAlignment="Center"
                                Content="Cancel Order">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Foreground" Value="#717FA6" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <TextBlock VerticalAlignment="Center"
                                                           FontSize="15"
                                                           FontWeight="Black"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           Text="Cancel Order"
                                                           TextAlignment="Center" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="#1F2E55" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>