<UserControl x:Class="FrontendMentor.OrderSummaryComponent.Views.OrderSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:buttons="clr-namespace:FrontendMentor.Assets.Controls.Buttons;assembly=FrontendMentor.Assets"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:FrontendMentor.Assets.Controls.Icons;assembly=FrontendMentor.Assets"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:properties="clr-namespace:FrontendMentor.OrderSummaryComponent.Properties"
             xmlns:viewModels="clr-namespace:FrontendMentor.OrderSummaryComponent.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:OrderSummaryViewModel}"
             x:ClassModifier="internal"
             mc:Ignorable="d">

    <Grid>
        <icons:Icon VerticalAlignment="Top"
                    Data="{StaticResource Wave.Geometry}"
                    Fill="{StaticResource OrderSummaryComponentView.WaveIcon.Fill.Brush}" />

        <Grid Width="450" VerticalAlignment="Center">
            <Border Margin="20"
                    Background="{StaticResource OrderSummaryComponentView.Card.BackgroundBorder.Background.Brush}"
                    CornerRadius="20"
                    Effect="{StaticResource OrderSummaryComponentView.BackgroundBorder.DropShadowEffect}">
                <Border.RenderTransform>
                    <TranslateTransform po:Freeze="True" Y="-20" />
                </Border.RenderTransform>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Height="220"
                        Background="{StaticResource OrderSummaryComponentView.Card.HeaderBorder.Background.Brush}"
                        ClipToBounds="True"
                        CornerRadius="20 20 0 0">
                    <Grid>
                        <icons:Icon HorizontalAlignment="Left"
                                    Data="{StaticResource City.Geometry}"
                                    Fill="{StaticResource OrderSummaryComponentView.Card.Header.CityIcon.Fill.Brush}">
                            <icons:Icon.RenderTransform>
                                <TranslateTransform po:Freeze="True" X="-8" Y="46" />
                            </icons:Icon.RenderTransform>
                        </icons:Icon>

                        <icons:Icon HorizontalAlignment="Left"
                                    Data="{StaticResource City.Geometry}"
                                    Fill="{StaticResource OrderSummaryComponentView.Card.Header.CityIcon.Fill.Brush}">
                            <icons:Icon.RenderTransform>
                                <TranslateTransform po:Freeze="True" X="196" Y="82" />
                            </icons:Icon.RenderTransform>
                        </icons:Icon>

                        <Image HorizontalAlignment="Left"
                               Source="{StaticResource MusicFlatLine.Image}"
                               Stretch="Uniform">
                            <Image.RenderTransform>
                                <TranslateTransform po:Freeze="True" X="34.54" Y="19" />
                            </Image.RenderTransform>
                        </Image>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Padding="48,45,48,48"
                        Background="{StaticResource OrderSummaryComponentView.Card.BodyBorder.Background.Brush}"
                        CornerRadius="0 0 20 20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading.L.TextBlock.Style}" Text="{x:Static properties:Resources.OrderSummaryComponentView_OrderSummaryTextBlock_Text}" />

                        <TextBlock Margin="0,17,0,0"
                                   Foreground="{StaticResource OrderSummaryComponentView.Card.BodyTextBlock.Foreground.Brush}"
                                   Style="{StaticResource Body.Multiline.TextBlock.Style}"
                                   Text="{x:Static properties:Resources.OrderSummaryComponentView_BodyTextBlock_Text}" />

                        <Border Margin="0,20,0,0"
                                Padding="24,25"
                                Background="{StaticResource OrderSummaryComponentView.Card.AnnualPlanBorder.Background.Brush}"
                                CornerRadius="11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Width="48"
                                      Height="48">
                                    <Ellipse Fill="{StaticResource OrderSummaryComponentView.Card.AnnualPlanMusicIconEllipse.Fill.Brush}" />

                                    <icons:Icon Height="18"
                                                Data="{StaticResource Music.Geometry}"
                                                Fill="{StaticResource OrderSummaryComponentView.Card.AnnualPlanMusicIcon.Fill.Brush}" />
                                </Grid>

                                <Grid Grid.Column="1" Margin="20,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Heading.M.TextBlock.Style}" Text="{x:Static properties:Resources.OrderSummaryComponentView_AnnualPlanTextBlock_Text}" />

                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{StaticResource OrderSummaryComponentView.Card.AnnualPlanPriceTextBlock.Foreground.Brush}"
                                                   Style="{StaticResource Body.TextBlock.Style}"
                                                   Text="{Binding OrderSummary.AnnualPlanPrice, StringFormat={x:Static properties:Resources.OrderSummaryComponentView_AnnualPlanPriceTextBlock_StringFormat}}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource Heading.XS.TextBlock.Style}">
                                        <Hyperlink Command="{Binding ChangeAnnualPlanCommand}" Style="{StaticResource Primary.Hyperlink.Style}">
                                            <Run Text="{x:Static properties:Resources.OrderSummaryComponentView_ChangeAnnualPlanTextBlock_Text}" />
                                        </Hyperlink>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Border>

                        <buttons:RoundedButton Margin="0,32,0,0"
                                               Command="{Binding ProceedToPaymentCommand}"
                                               IsDefault="True"
                                               Style="{StaticResource Primary.Button.Style}">
                            <TextBlock Foreground="{StaticResource OrderSummaryComponentView.Card.ProceedToPaymentTextBlock.Foreground.Brush}"
                                       Style="{StaticResource Heading.S.TextBlock.Style}"
                                       Text="{x:Static properties:Resources.OrderSummaryComponentView_ProceedToPaymentTextBlock_Text}" />
                        </buttons:RoundedButton>

                        <Button Margin="0,32,0,0"
                                HorizontalAlignment="Center"
                                Command="{Binding CancelOrderCommand}"
                                IsCancel="True"
                                Style="{StaticResource Secondary.Button.Style}">
                            <TextBlock Style="{StaticResource Heading.S.TextBlock.Style}" Text="{x:Static properties:Resources.OrderSummaryComponentView_CancelOrderTextBlock_Text}" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>