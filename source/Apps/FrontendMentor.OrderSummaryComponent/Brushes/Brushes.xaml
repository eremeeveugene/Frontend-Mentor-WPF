<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:resourceDictionaries="clr-namespace:FrontendMentor.Assets.ResourceDictionaries;assembly=FrontendMentor.Assets">

    <ResourceDictionary.MergedDictionaries>
        <resourceDictionaries:SharedResourceDictionary Source="pack://application:,,,/FrontendMentor.OrderSummaryComponent;component/Colors/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--#region OrderSummaryComponentWindow-->

    <SolidColorBrush x:Key="OrderSummaryComponentWindow.Background.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Lavender.Color}" />

    <SolidColorBrush x:Key="OrderSummaryComponentWindow.Foreground.Brush"
                     po:Freeze="True"
                     Color="{StaticResource Space.Cadet.Color}" />

    <!--#endregion-->

</ResourceDictionary>