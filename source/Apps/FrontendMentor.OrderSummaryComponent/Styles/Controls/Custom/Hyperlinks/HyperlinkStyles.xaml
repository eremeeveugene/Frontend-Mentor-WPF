<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="Primary.Hyperlink.Style" TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="#382AE1" />
        <Setter Property="TextDecorations" Value="{x:Static TextDecorations.Underline}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#766CF1" />
                <Setter Property="TextDecorations" Value="{x:Null}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>