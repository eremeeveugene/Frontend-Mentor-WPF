<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ControlTemplate x:Key="Primary.Button.Template" TargetType="{x:Type Button}">
        <Border Background="{TemplateBinding Background}" CornerRadius="11">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
    </ControlTemplate>

    <Style x:Key="Primary.Button.Style" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#382AE1" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20"
                                  Direction="270"
                                  Opacity="0.15"
                                  ShadowDepth="20"
                                  Color="#382AE1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Height" Value="50" />
        <Setter Property="Template" Value="{StaticResource Primary.Button.Template}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#766CF1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="Secondary.Button.Template" TargetType="{x:Type Button}">
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
    </ControlTemplate>

    <Style x:Key="Secondary.Button.Style" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="#717FA6" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource Secondary.Button.Template}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#1F2E55" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>